## Extending Attention

A simplistic implementation of multi-head causal attention written in Elixir while working through Chapter 3 of Build a Large Language Model (from Scratch). The goal of this code is clarity and intuition rather than completeness or performance. For a full explanation of the concepts and design decisions, see the accompanying blog post: [https://latentwords.com](https://www.latentwords.com/multi-head-attention-in-elixir/)

In the previous step, we introduced causal masking and dropout to make attention work for language modeling. In this notebook, we extend that same mechanism into multi-head attention. Instead of a single attention pattern, we split the representation into multiple heads, compute attention in parallel, and then merge the results back together. This lets the model capture different types of relationships across the same sequence.

```elixir
defmodule MultiHeadAttention do
  import Nx.Defn

  def init_embedding({rows, cols}, key) do
    Nx.Random.uniform(key, 0.0, 1.0, shape: {rows, cols}, type: {:f, 32})
  end

  def embed(token_ids, token_embeddings) do
    Nx.take(token_embeddings, token_ids)
  end

  # Initializes multi-head attention projection weights.
  # Raises if d_out is not divisible by num_heads.
  def init({d_in, d_out}, num_heads, key) do
    unless rem(d_out, num_heads) == 0 do
      raise ArgumentError,
            "d_out (#{d_out}) must be divisible by num_heads (#{num_heads})"
    end

    {w_q, key} = init_weight({d_in, d_out}, key)
    {w_k, key} = init_weight({d_in, d_out}, key)
    {w_v, key} = init_weight({d_in, d_out}, key)
    # Output projection maps the concatenated heads back to d_out.
    {w_o, key} = init_weight({d_out, d_out}, key)

    w_q = Nx.rename(w_q, [:in_dim, :out_dim])
    w_k = Nx.rename(w_k, [:in_dim, :out_dim])
    w_v = Nx.rename(w_v, [:in_dim, :out_dim])
    w_o = Nx.rename(w_o, [:merged_dim, :out_dim])
    {%{w_q: w_q, w_k: w_k, w_v: w_v, w_o: w_o, num_heads: num_heads}, key}
  end

  # Xavier/Glorot uniform initialization: keeps activations stable across layers
  defp init_weight({d_in, d_out}, key) do
    limit = :math.sqrt(6.0 / (d_in + d_out))
    Nx.Random.uniform(key, -limit, limit, shape: {d_in, d_out}, type: {:f, 32})
  end

  # Forward pass for batched multi-head causal self-attention.
  def attention(x, %{w_q: w_q, w_k: w_k, w_v: w_v, w_o: w_o, num_heads: num_heads}, key, opts \\ []) do
    training = Keyword.get(opts, :training, false)
    dropout_rate = Keyword.get(opts, :dropout_rate, 0.1)

    {q, k, v, scale} = project_and_split(x, w_q, w_k, w_v, num_heads)

    if training do
      keep_prob = 1.0 - dropout_rate
      attention_train(q, k, v, w_o, scale, key, keep_prob)
    else
      {weights, context} = attention_eval(q, k, v, w_o, scale)
      {weights, context, key}
    end
  end

  # Projects x through w_q/w_k/w_v and splits into heads.
  defp project_and_split(x, w_q, w_k, w_v, num_heads) do
    {batch, seq_len, _d_in} = Nx.shape(x)
    d_out = Nx.axis_size(w_q, :out_dim)
    head_dim = div(d_out, num_heads)
    scale = Nx.tensor(:math.sqrt(head_dim), type: {:f, 32})

    split = fn w, seq_name ->
      x
      |> Nx.dot([:in_dim], w, [:in_dim])
      |> Nx.rename([:batch, :seq, :out_dim])
      |> Nx.reshape({batch, seq_len, num_heads, head_dim}, names: [:batch, seq_name, :head, :dim])
      |> Nx.transpose(axes: [:batch, :head, seq_name, :dim])
    end

    {
      split.(w_q, :query_pos),
      split.(w_k, :key_pos),
      split.(w_v, :value_pos),
      scale
    }
  end

  # Training path: applies inverted dropout to attention probabilities.
  # Receives pre-projected, head-split tensors from project_and_split/5.
  defn attention_train(q, k, v, w_o, scale, key, keep_prob) do
    attn_weights = compute_attn_weights(q, k, scale)
    {dropped_weights, new_key} = dropout(attn_weights, key, keep_prob)
    context = compute_context(dropped_weights, v, w_o)
    {dropped_weights, context, new_key}
  end

  # Eval path: no dropout.
  defn attention_eval(q, k, v, w_o, scale) do
    attn_weights = compute_attn_weights(q, k, scale)
    context = compute_context(attn_weights, v, w_o)
    {attn_weights, context}
  end

  # Scaled dot-product attention scores → softmax weights.
  defnp compute_attn_weights(q, k, scale) do
    q
    |> Nx.dot([:dim], [:batch, :head], k, [:dim], [:batch, :head])
    |> Nx.rename([:batch, :head, :query_pos, :key_pos])
    |> Nx.divide(scale)
    |> apply_causal_mask()
    |> softmax()
  end

  # Weighted sum over values, merge heads, apply output projection.
  defnp compute_context(weights, v, w_o) do
    {batch, num_heads, seq_len, head_dim} = Nx.shape(v)
    d_out = num_heads * head_dim

    weights
    |> Nx.dot([:key_pos], [:batch, :head], v, [:value_pos], [:batch, :head])
    |> Nx.rename([:batch, :head, :query_pos, :dim])
    |> Nx.transpose(axes: [:batch, :query_pos, :head, :dim])
    |> Nx.reshape({batch, seq_len, d_out}, names: [:batch, :seq, :merged_dim])
    |> Nx.dot([:merged_dim], w_o, [:merged_dim])
  end

  # Inverted dropout: keep with probability `keep_prob`, scale by `1 / keep_prob`.
  defn dropout(weights, key, keep_prob) do
    {noise, new_key} = Nx.Random.uniform(key, shape: Nx.shape(weights), type: {:f, 32})
    mask = Nx.as_type(Nx.less(noise, keep_prob), {:f, 32})
    scaled = weights * mask / keep_prob
    {scaled, new_key}
  end

  # Fills the strict upper triangle with -1e9 before softmax.
  defn apply_causal_mask(scores) do
    seq_len = Nx.axis_size(scores, :query_pos)
    mask = Nx.broadcast(Nx.tri(seq_len, seq_len), scores)
    Nx.select(mask, scores, Nx.broadcast(Nx.Constants.neg_infinity(), scores))
  end

  # Numerically stable last-axis softmax.
  defn softmax(scores) do
    max = Nx.reduce_max(scores, axes: [-1], keep_axes: true)
    exp = Nx.exp(scores - max)
    exp / Nx.sum(exp, axes: [-1], keep_axes: true)
  end
end
```

## End-to-end example of multi-head attention

Next, run a small example to see everything working end-to-end.

* tokenize a simple sentence
* create a random embedding table
* initialize the multi-head attention parameters
* convert tokens into embeddings and shaped into a batch of size one
* pass the input through the attention function, which projects the embeddings into queries, keys, and values, splits them into heads
* apply causal attention (with optional dropout during training)
* finally merge the heads back into a single context vector per token.

The result includes both the attention weights (one per head) and the resulting contextual representations.

```elixir
text = "Your journey starts with one step"
tokens = Gpt3Tokenizer.encode(text)

vocab_size = Enum.max(tokens) + 1
embedding_dim = 8
d_out = 4
num_heads = 2

# Fixed seed for reproducible output. Change for real-world randomness.
key = Nx.Random.key(42)
{token_embeddings, key} = MultiHeadAttention.init_embedding({vocab_size, embedding_dim}, key)
{params, key} = MultiHeadAttention.init({embedding_dim, d_out}, num_heads, key)

# Batch of size 1: [batch=1, seq_len]
token_ids = Nx.tensor([tokens])
x = MultiHeadAttention.embed(token_ids, token_embeddings)
  |> Nx.rename([:batch, :seq, :in_dim])

{attn_weights, context, _key} =
  MultiHeadAttention.attention(x, params, key, training: true, dropout_rate: 0.5)

IO.inspect(attn_weights, label: "Attention weights")
IO.inspect(context, label: "Context vectors")
:ok
```
